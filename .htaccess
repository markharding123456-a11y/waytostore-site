# Way To Store Self Storage - Apache/LiteSpeed config for 4GoodHosting cPanel
ErrorDocument 404 /404.html

# Serve index.html for /blog/ and any other directory
DirectoryIndex index.html

# Canonical host: force HTTPS and the bare domain (no www). Verified 2026-09-21: http://, https://www. and https://
# all answer 200 with no redirect, which would split ranking signals at launch.
# ENABLE (remove the leading '# ' on the six lines below) ONLY AFTER cPanel AutoSSL has issued certificates for
# BOTH waytostore.ca and www.waytostore.ca, or visitors get certificate errors.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} ^www\. [NC]
#   RewriteRule ^ https://waytostore.ca%{REQUEST_URI} [L,R=301]
# </IfModule>

# Cache static assets for a week
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
